@model IndexViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-container">
    <div class="dashboard-top-nav">
        <div class="user-greeting">
            <i class="fa-solid fa-circle-user"></i>
            <span>@Model?.User.FullName</span>
        </div>

        <form asp-controller="Account" asp-action="Logout" method="post" style="margin: 0;">
            <button type="submit" class="logout-btn">
                <i class="fa-solid fa-arrow-right-from-bracket"></i> Log Out
            </button>
        </form>
    </div>

    <!-- Dashboard Header -->
    <div class="dashboard-header">
        <h2 class="dashboard-title">
            Welcome back
        </h2>
        <p class="dashboard-subtitle">
            Manage your CV drafts or start a new template.
        </p>
    </div>

    <!-- The Action Cards Grid -->
    <div class="dashboard-grid">

        <!-- CARD 1: Create New CV -->
        <a asp-controller="CvBuilder" asp-action="NewCV" class="dashboard-card" id="newCvBtn" data-has-draft="@Model.HasDraft.ToString().ToLower()">
            <div class="card-icon-wrapper">
                <i class="fa-solid fa-plus card-icon"></i>
            </div>
            <h5 class="card-title" style="padding-bottom:10px;">Create New CV</h5>
            <p class="card-text">Start a blank ATS-friendly template from scratch.</p>
        </a>

        <!-- CARD 2: Resume Draft -->
        @if (Model.HasDraft)
        {
            <a href="/CvBuilder/PersonalInfo/1" class="dashboard-card">
                <div class="card-icon-wrapper">
                    <i class="fa-solid fa-file-pen card-icon"></i>
                </div>
                <h5 class="card-title">Edit CV</h5>
                <p class="card-text">Continue working on your existing CV draft.</p>
            </a>
        }
        else
        {
            <button class="dashboard-card" disabled>
                <div class="card-icon-wrapper">
                    <i class="fa-solid fa-file-pen card-icon"></i>
                </div>
                <h5 class="card-title">Edit CV</h5>
                <p class="card-text">Continue working on your existing CV draft.</p>
                <span class="draft-badge">In Progress</span>
            </button>
        }
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const btn = document.getElementById('newCvBtn');

        if (!btn) return;

        btn.addEventListener('click', function(e) {
            const hasDraft = this.dataset.hasDraft === 'true';
            const targetUrl = this.getAttribute('href');

            if (hasDraft) {
                e.preventDefault();

                Swal.fire({
                    title: 'Start a new CV?',
                    text: 'You already have a saved draft. Starting a new CV will permanently delete it.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, delete and start new',
                    cancelButtonText: 'Cancel',
                    reverseButtons: true,
                    background: '#0B111A',
                    customClass: {
                        popup: 'my-swal-popup',
                        title: 'my-swal-title',
                        htmlContainer: 'my-swal-text',
                        confirmButton: 'my-swal-confirm',
                        cancelButton: 'my-swal-cancel',
                        icon: 'my-swal-icon'
                    },
                    buttonsStyling: false
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = targetUrl;
                    }
                });
            }
        });
    });
</script>

