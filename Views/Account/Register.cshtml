@model ATS_CV_Generator.Models.RegisterViewModel

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="cv-card">
                <h2 class="mb-4" style="color: var(--primary-navy);">Create Your Account</h2>
                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="color: var(--error);"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label" style="color: var(--text-secondary);">Full Name</label>
                        <input asp-for="FullName" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label" style="color: var(--text-secondary);">Email Address</label>
                        <input asp-for="Email" class="form-control" type="email" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label" style="color: var(--text-secondary);">Password</label>
                        <input asp-for="Password" class="form-control" type="password" />
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label" style="color: var(--text-secondary);">Confirm Password</label>
                        <input asp-for="ConfirmPassword" class="form-control" type="password" />
                    </div>

                    <button type="submit" class="btn btn-navy w-100 py-2">Sign Up & Build CV</button>
                </form>
            </div>
        </div>
    </div>
</div>