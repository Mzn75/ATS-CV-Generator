@model ATS_CV_Generator.Models.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-12">
            <h1 class="mb-4 text-center" style="color: var(--text-primary); font-weight:900;">
                ATS-Friendly CV Generator
            </h1>
        </div>
    </div>

    <div class="page-columns">

        <div class="form-col">
            <div class="d-lg-none mb-4 text-center" style="margin-top: 30px;">
                <button type="button" class="modern-mobile-btn" data-bs-toggle="modal" data-bs-target="#mobilePreviewModal">
                    <i class="fa-solid fa-eye me-2"></i> Preview CV Template
                </button>
            </div>
            <h5 class="mb-4 form-col-tagline" style="color: var(--text-primary); text-align: center; font-family:'Inter';">
                Generate Yours Now, For Free!
            </h5>
            <div class="inputs-card">
                <h2 class="mb-4" style="color: var(--text-primary); text-align: center; font-weight:900;">Create Your Account</h2>
                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="color: var(--error);"></div>

                    <div class="mb-3 position-relative">
                        <label asp-for="FullName" class="form-label" style="color: var(--text-secondary);">Full Name</label>
                        <input asp-for="FullName" class="form-control input-with-icon" placeholder="Enter your full name"/>
                        <i class="fa-solid fa-user custom-input-icon"></i>
                        <span asp-validation-for="FullName" class="field-validation-error"></span>
                    </div>

                    <div class="mb-3 position-relative">
                        <label asp-for="Email" class="form-label" style="color: var(--text-secondary);">Email Address</label>
                        <input asp-for="Email" class="form-control input-with-icon" type="email" placeholder="Enter your email" />
                        <i class="fa-solid fa-envelope custom-input-icon"></i>
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </div>

                    <div class="mb-3 position-relative">
                        <label asp-for="Password" class="form-label" style="color: var(--text-secondary);">Password</label>
                        <input asp-for="Password" class="form-control input-with-icon" type="password" placeholder="Create your password" />
                        <i class="fa-solid fa-lock custom-input-icon"></i>
                        <span class="password-toggle" id="togglePassword">
                            <i class="fa-solid fa-eye"></i>
                        </span>
                        <span asp-validation-for="Password" class="field-validation-error"></span>
                    </div>

                    <div class="mb-4 position-relative">
                        <label asp-for="ConfirmPassword" class="form-label" style="color: var(--text-secondary);">Confirm Password</label>
                        <input asp-for="ConfirmPassword" class="form-control input-with-icon" type="password" placeholder="Confirm your password" />
                        <i class="fa-solid fa-lock custom-input-icon"></i>
                        <span class="password-toggle" id="toggleConfirmPassword">
                            <i class="fa-solid fa-eye"></i>
                        </span>
                        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                    </div>

                    <div class="mt-5 d-flex justify-content-center">
                        <button id="animatedSaveBtn" type="submit" class="btn btn-animate w-100 py-2" data-text="Sign Up"></button>
                    </div>
                    <hr style="color: var(--secondary-teal)"/>
                    <h6 class="mb-4 developed-by" style="color: var(--text-primary); text-align: center; font-family:'Inter';">
                        Already have an account? <a asp-controller="Account" asp-action="Login" style="color: var(--secondary-teal)">Log In</a>
                    </h6>
                </form>
            </div>
            <h6 class="mb-4 developed-by" style="color: var(--text-primary); text-align: center; font-family:'Inter';">
                Developed By: <span style="color: var(--secondary-teal)">Mazen Thobian</span>
            </h6>
        </div>
        <div class="page-divider col-lg-2 d-none d-lg-flex"></div>
        <div class="preview-col col-lg-5 d-none d-lg-block">
            <div class="preview-img-card">
                <partial name="_CvPreviewCard" />
            </div>
        </div>
    </div>
    <!-- MOBILE PREVIEW MODAL -->
    <div class="modal fade" id="mobilePreviewModal" tabindex="-1" aria-hidden="true">
        <!-- modal-dialog-scrollable makes sure they can scroll if the CV is really tall -->
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content" style="background-color: var(--surface-dark); border: 1px solid #38546d;">

                <div class="modal-header" style="border-bottom: 1px solid #38546d;">
                    <h5 class="modal-title" style="color: #ffffff; font-family: 'Montserrat', sans-serif;">CV Preview</h5>
                    <!-- The close button -->
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <!-- We just reuse your exact same partial view! -->
                    <partial name="_CvPreviewCard" />
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Sign Up Button Animations
        $(document).ready(function() {
            $("#animatedSaveBtn").on("click", function(e) {
                e.preventDefault();

                var $btn = $(this);
                var $form = $btn.closest("form");

                // Wake up ASP.NET validation just in case
                $form.removeData("validator").removeData("unobtrusiveValidation");
                $.validator.unobtrusive.parse($form);

                // Check if the form is valid
                if (!$form.valid()) {
                    // Trigger the Red 'X'
                    $btn.addClass("error-state");

                    setTimeout(function() {
                        $btn.removeClass("error-state");
                    }, 2000);

                    return; // Stop animation
                }

                // If valid, run the success animation
                $btn.addClass("onclic");

                setTimeout(function() {
                    $btn.removeClass("onclic").addClass("validate");

                    setTimeout(function() {
                        $btn.removeClass("validate");
                        $form.submit(); // Submit to Register method
                    }, 1250);
                }, 2000);
            });
        });

        // Password Toggle "Eye Icon"
        $(document).ready(function() {
            $("#togglePassword").on("click", function() {
                var $input = $("#Password");
                var $icon = $(this).find("i");

                if ($input.attr("type") === "password") {
                    // Show password and change icon to 'slash'
                    $input.attr("type", "text");
                    $icon.removeClass("fa-eye").addClass("fa-eye-slash");
                } else {
                    // Hide password and change icon back to 'eye'
                    $input.attr("type", "password");
                    $icon.removeClass("fa-eye-slash").addClass("fa-eye");
                }
            });
        });

        // Confirm Password Toggle "Eye Icon"
        $(document).ready(function() {
            $("#toggleConfirmPassword").on("click", function() {
                var $input = $("#ConfirmPassword");
                var $icon = $(this).find("i");

                if ($input.attr("type") === "password") {
                    // Show password and change icon to 'slash'
                    $input.attr("type", "text");
                    $icon.removeClass("fa-eye").addClass("fa-eye-slash");
                } else {
                    // Hide password and change icon back to 'eye'
                    $input.attr("type", "password");
                    $icon.removeClass("fa-eye-slash").addClass("fa-eye");
                }
            });
        });
    </script>
}
