@model CvDraft
@{
    ViewData["Title"] = "Personal Information";
}

<div class="builder-container mx-auto" style="max-width: 700px; margin-top: 40px;">

    <!-- PROGRESS BAR -->
    <div class="step-indicator" style="padding-top:20px">
        <a asp-controller="CvBuilder" asp-action="PersonalInfo" class="step active">
            <div class="step-circle">1</div>
            <span class="step-label">Personal</span>
        </a>
        <a asp-controller="CvBuilder" asp-action="Education" class="step">
            <div class="step-circle">2</div>
            <span class="step-label">Education</span>
        </a>
        <a asp-controller="CvBuilder" asp-action="Experience" class="step">
            <div class="step-circle">3</div>
            <span class="step-label">Experience</span>
        </a>
        <a asp-controller="CvBuilder" asp-action="Projects" class="step">
            <div class="step-circle">4</div>
            <span class="step-label">Projects</span>
        </a>
        <a asp-controller="CvBuilder" asp-action="Certificates" class="step">
            <div class="step-circle">5</div>
            <span class="step-label">Certificates</span>
        </a>
        <a asp-controller="CvBuilder" asp-action="Skills" class="step">
            <div class="step-circle">6</div>
            <span class="step-label">Skills</span>
        </a>
        <a asp-controller="CvBuilder" asp-action="Result" class="step">
            <div class="step-circle">7</div>
            <span class="step-label">Result</span>
        </a>
    </div>

    <h2 class="mb-4" style="color: #ffffff; font-weight: 700;">1. Personal Information</h2>

    <!-- THE FORM -->
    <form asp-action="PersonalInfo" method="post" id="form">
        <!-- Hidden ID so Entity Framework knows which draft to update -->
        <input type="hidden" asp-for="Id" />

        <div class="inputs-card">
            <div class="row">
                <!-- Full Name -->
                <div class="col-md-6 mb-3">
                    <label asp-for="FullName" class="form-label" style="color: var(--text-secondary);">Full Name</label>

                    <div class="position-relative">
                        <input asp-for="FullName" class="form-control input-with-icon" type="text" placeholder="Enter your full name" />
                        <i class="fa-solid fa-user custom-input-icon"></i>
                        <span asp-validation-for="FullName" class="field-validation-error text-danger"></span>
                    </div>
                </div>

                <!-- Email Address -->
                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="form-label" style="color: var(--text-secondary);">Email Address</label>

                    <div class="position-relative">
                        <input asp-for="Email" class="form-control input-with-icon" type="email" placeholder="Enter your email" />
                        <i class="fa-solid fa-envelope custom-input-icon"></i>
                        <span asp-validation-for="Email" class="field-validation-error text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <!-- Phone Number -->
                <div class="col-md-6 mb-3">
                    <label asp-for="PhoneNumber" class="form-label" style="color: var(--text-secondary);">Phone Number</label>

                    <div class="position-relative">
                        <input asp-for="PhoneNumber" class="form-control input-with-icon" type="tel" placeholder="Enter your phone number" />
                        <i class="fa-solid fa-phone custom-input-icon"></i>
                        <span asp-validation-for="PhoneNumber" class="field-validation-error text-danger"></span>
                    </div>
                </div>

                <!-- Target Job Title -->
                <div class="col-md-6 mb-3">
                    <label asp-for="JobTitle" class="form-label" style="color: var(--text-secondary);">Target Job Title</label>
                    <div class="position-relative">
                        <input asp-for="JobTitle" class="form-control input-with-icon" type="text" placeholder="e.g., Software Engineer" />
                        <i class="fa-solid fa-briefcase custom-input-icon"></i>
                        <span asp-validation-for="JobTitle" class="field-validation-error text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <!-- Country -->
                <div class="col-md-6 mb-3">
                    <label asp-for="Country" class="form-label" style="color: var(--text-secondary);">Country</label>

                    <div class="position-relative">
                        <input asp-for="Country" class="form-control input-with-icon" type="text" placeholder="Enter your country" />
                        <i class="fa-solid fa-location-dot custom-input-icon"></i>
                        <span asp-validation-for="Country" class="field-validation-error text-danger"></span>
                    </div>
                </div>
                
                <!-- City -->
                <div class="col-md-6 mb-3">
                    <label asp-for="City" class="form-label" style="color: var(--text-secondary);">City</label>

                    <div class="position-relative">
                        <input asp-for="City" class="form-control input-with-icon" type="text" placeholder="Enter your city" />
                        <i class="fa-solid fa-location-dot custom-input-icon"></i>
                        <span asp-validation-for="City" class="field-validation-error text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <!-- Linked In -->
                <div class="col-md-6 mb-3">
                    <label asp-for="LinkedInUrl" class="form-label" style="color: var(--text-secondary);">LinkedIn Profile</label>

                    <div class="position-relative">
                        <input asp-for="LinkedInUrl" class="form-control input-with-icon" type="url" placeholder="https://www.linkedin.com/in/..." />
                        <i class="fa-brands fa-linkedin-in custom-input-icon"></i>
                        <span asp-validation-for="LinkedInUrl" class="field-validation-error text-danger"></span>
                    </div>
                </div>

                <!-- GitHub -->
                <div class="col-md-6 mb-3">
                    <label asp-for="GitHubUrl" class="form-label" style="color: var(--text-secondary);">GitHub Profile</label>
                    <div class="position-relative">
                        <input asp-for="GitHubUrl" class="form-control input-with-icon" type="url" placeholder="https://github.com/..." />
                        <i class="fa-brands fa-github custom-input-icon"></i>
                        <span asp-validation-for="GitHubUrl" class="field-validation-error text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Professional Summary -->
            <div class="mb-3">
                <label asp-for="ProfessionalSummary" class="form-label" style="color: var(--text-secondary);">Professional Summary</label>
                <div class="position-relative">
                    <textarea asp-for="ProfessionalSummary" class="form-control input-with-icon" rows="5" placeholder="Enter a brief description about your professional background and top skills..." style="resize: none; padding-top: 12px;"></textarea>
                    <i class="fa-solid fa-align-left custom-input-icon" style="top:49px"></i>
                    <span asp-validation-for="ProfessionalSummary" class="field-validation-error text-danger"></span>
                </div>
            </div>
        </div>
        <!-- Navigation Buttons -->
        <div class="nav-buttons d-flex justify-content-between mt-4">
            <!-- Back / Dashboard -->
            <a asp-controller="Home" asp-action="Index"
               class="btn btn-nav btn-nav-back px-5 py-2">
                <i class="fa-solid fa-arrow-left me-2"></i> Dashboard
            </a>

            <!-- Next -->
            <button type="submit" class="btn btn-nav btn-nav-next px-5 py-2">
                Next: Education <i class="fa-solid fa-arrow-right ms-2"></i>
            </button>
        </div>
    </form>
</div>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const form = document.getElementById("form");
            if (!form) return;

            // Grab all inputs and textareas inside the form
            const inputs = form.querySelectorAll("input, textarea");

            inputs.forEach(input => {
                // Ignore hidden inputs (like the ID field)
                if (input.type === 'hidden' || !input.name) return;

                // 1. RESTORE DATA: If the input is empty, check if we have saved data
                if (!input.value) {
                    const savedValue = sessionStorage.getItem('cvDraft_' + input.name);
                    if (savedValue) {
                        input.value = savedValue;
                    }
                }

                // 2. SAVE DATA: As the user types, save it to Session Storage
                input.addEventListener("input", function() {
                    sessionStorage.setItem('cvDraft_' + input.name, input.value);
                });
            });

            // 3. CLEAN UP: When they officially submit, wipe the temporary storage
            form.addEventListener("submit", function() {
                inputs.forEach(input => {
                    if (input.name) {
                        sessionStorage.removeItem('cvDraft_' + input.name);
                    }
                });
            });
        });
    </script>
}