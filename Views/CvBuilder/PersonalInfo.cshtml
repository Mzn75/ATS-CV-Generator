@model CvDraft
@{
    ViewData["Title"] = "Personal Information";
}

<div class="builder-container mx-auto" style="max-width: 700px; margin-top: 40px;">

    <!-- PROGRESS BAR -->
    <div class="progress-wrapper mb-5">
        <div class="d-flex justify-content-between mb-2" style="color: var(--text-secondary); font-size: 0.9rem; font-weight: 600;">
            <span>Step 1: Personal Information</span>
            <span>15%</span>
        </div>
        <div class="progress" style="height: 8px; background-color: #2a2b38; border-radius: 4px; overflow: hidden;">
            <div class="progress-bar" role="progressbar" style="width: 15%; background-color: var(--secondary-teal, --accent-coral);"></div>
        </div>
    </div>

    <h2 class="mb-4" style="color: #ffffff; font-weight: 700;">Let's start with the basics</h2>
    <p style="color: var(--text-secondary); margin-bottom: 30px;">
        This information will be placed at the top of your CV. Review your account details below and update them if necessary.
    </p>

    <!-- THE FORM -->
    <form asp-action="PersonalInfo" method="post">
        <!-- Hidden ID so Entity Framework knows which draft to update -->
        <input type="hidden" asp-for="Id" />

        <div class="row">
            <!-- Full Name -->
            <div class="col-md-6 mb-3">
                <label asp-for="FullName" class="form-label" style="color: var(--text-secondary);">Full Name</label>
            
                <div class="position-relative">
                    <input asp-for="FullName" class="form-control input-with-icon" type="text" placeholder="Enter your full name" />
                    <i class="fa-regular fa-user custom-input-icon"></i>
                    <span asp-validation-for="FullName" class="field-validation-error text-danger"></span>
                </div>
            </div>

            <!-- Email Address -->
            <div class="col-md-6 mb-3">
                <label asp-for="Email" class="form-label" style="color: var(--text-secondary);">Email Address</label>
            
                <div class="position-relative">
                    <input asp-for="Email" class="form-control input-with-icon" type="email" placeholder="Enter your email" />
                    <i class="fa-regular fa-envelope custom-input-icon"></i>
                    <span asp-validation-for="Email" class="field-validation-error text-danger"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Phone Number -->
            <div class="col-md-6 mb-3">
                <label asp-for="PhoneNumber" class="form-label" style="color: var(--text-secondary);">Phone Number</label>
                
                <div class="position-relative">
                    <input asp-for="PhoneNumber" class="form-control input-with-icon" type="tel" placeholder="Enter your phone number"/>
                    <i class="fa-solid fa-phone custom-input-icon"></i>
                    <span asp-validation-for="PhoneNumber" class="field-validation-error text-danger"></span>
                </div>
            </div>

            <!-- Target Job Title -->
            <div class="col-md-6 mb-3">
                <label asp-for="JobTitle" class="form-label" style="color: var(--text-secondary);">Target Job Title</label>
                <div class="position-relative">
                    <input asp-for="JobTitle" class="form-control input-with-icon" type="text" placeholder="e.g., Software Engineer" />
                    <i class="fa-solid fa-briefcase custom-input-icon"></i>
                    <span asp-validation-for="JobTitle" class="field-validation-error text-danger"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Linked In -->
            <div class="col-md-6 mb-3">
                <label asp-for="LinkedInUrl" class="form-label" style="color: var(--text-secondary);">LinkedIn Profile</label>

                <div class="position-relative">
                    <input asp-for="LinkedInUrl" class="form-control input-with-icon" type="url" placeholder="https://www.linkedin.com/in/..." />
                    <i class="fa-brands fa-linkedin-in custom-input-icon"></i>
                    <span asp-validation-for="LinkedInUrl" class="field-validation-error text-danger"></span>
                </div>
            </div>

            <!-- GitHub -->
            <div class="col-md-6 mb-3">
                <label asp-for="GitHubUrl" class="form-label" style="color: var(--text-secondary);">GitHub Profile</label>
                <div class="position-relative">
                    <input asp-for="GitHubUrl" class="form-control input-with-icon" type="url" placeholder="https://github.com/..." />
                    <i class="fa-brands fa-github custom-input-icon"></i>
                    <span asp-validation-for="GitHubUrl" class="field-validation-error text-danger"></span>
                </div>
            </div>
        </div>

        <!-- Professional Summary -->
        <div class="mb-3">
            <label asp-for="ProfessionalSummary" class="form-label" style="color: var(--text-secondary);">Professional Summary</label>
            <div class="position-relative">
            <!-- Using a textarea instead of an input for longer text -->
            <textarea asp-for="ProfessionalSummary" class="form-control input-with-icon" rows="5" placeholder="Briefly describe your professional background and top skills..." style="resize: none; padding-top: 12px;"></textarea>
            <i class="fa-solid fa-align-left custom-input-icon" style="top:49px"></i>
            <span asp-validation-for="ProfessionalSummary" class="field-validation-error text-danger"></span>
            </div>
        </div>

        <!-- Navigation Buttons -->
        <div class="nav-buttons d-flex justify-content-between mt-4">
            <!-- Back / Dashboard -->
            <a asp-controller="Home" asp-action="Index"
               class="btn btn-nav btn-nav-back px-5 py-2">
                <i class="fa-solid fa-arrow-left me-2"></i> Dashboard
            </a>

            <!-- Next -->
            <button type="submit" class="btn btn-nav btn-nav-next px-5 py-2">
                Next: Education <i class="fa-solid fa-arrow-right ms-2"></i>
            </button>
        </div>
    </form>
</div>
