@model ATS_CV_Generator.Models.CvDraft
@{
    Layout = null;
}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:wght@400;700&display=swap">
<script type="importmap"></script>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<link rel="stylesheet" href="~/ATS_CV_Generator.styles.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/cv.css">

    <div class="cv-preview" style="padding-top:50px;" id="cv">

        <div class="cv-header">
            <p class="cv-name">@Model.FullName</p>
            <p class="cv-title">@Model.JobTitle</p>
            <p class="cv-contact">
                <span class="cv-contact-item">@Model.Country, @Model.City</span>
                <span class="cv-sep">|</span>
                <span class="cv-contact-item"><i class="fa-solid fa-envelope"></i> <a href="mailto:@Model.Email">@Model.Email</a></span>
                <span class="cv-sep">|</span>
                <span class="cv-contact-item"><i class="fa-solid fa-phone"></i> <a href="tel:@Model.PhoneNumber">@Model.PhoneNumber</a></span>
                <span class="cv-sep">|</span>
                <span class="cv-contact-item"><i class="fa-brands fa-github"></i> <a href="@Model.GitHubUrl">GitHub</a></span>
                <span class="cv-sep">|</span>
                <span class="cv-contact-item"><i class="fa-brands fa-linkedin"></i> <a href="@Model.LinkedInUrl">LinkedIn</a></span>
            </p>
        </div>

        <p class="cv-section-title" style="margin-top: 8px;">Summary</p>
        <p class="cv-summary">
            @Model.ProfessionalSummary
        </p>

        <p class="cv-section-title">Education</p>

        @if (Model.Educations != null && Model.Educations.Any())
        {
            @foreach (var edu in Model.Educations)
            {
                <div class="cv-row">
                    <div class="left">
                        <strong>@edu.Institution</strong>
                        <span class="sub">Major: @edu.Major</span>
                    </div>
                    <div class="right">@DateTime.Parse(edu.GradDate).ToString("MMM yyyy")</div>
                </div>
            }
        }
        <p class="cv-section-title">Experience</p>
        <div class="cv-block">
            @if (Model.Experiences != null && Model.Experiences.Any())
            {
                @foreach (var exp in Model.Experiences)
                {
                    <div class="cv-row">
                        <div class="left">
                            <strong>@exp.JobTitle</strong>
                            <span class="sub">@exp.Company</span>
                        </div>
                        <div class="right">@DateTime.Parse(exp.StartDate).ToString("MMM yyyy") &ndash; @DateTime.Parse(exp.EndDate).ToString("MMM yyyy")</div>
                    </div>
                    <ul class="cv-bullets">
                        <li>@exp.Description</li>
                    </ul>
                }
            }
        </div>

        <p class="cv-section-title">Projects</p>
        <div class="cv-block">
            @if (Model.Projects != null && Model.Projects.Any())
            {
                @foreach (var proj in Model.Projects)
                {
                    <div class="cv-row">
                        <div class="left"><strong>@proj.ProjectName</strong></div>
                        <div class="right">@DateTime.Parse(@proj.StartDate).ToString("MMM yyyy") &ndash; @DateTime.Parse(@proj.EndDate).ToString("MMM yyyy")</div>
                    </div>
                    <ul class="cv-bullets">
                        <li>@proj.Description</li>
                    </ul>
                }
            }
        </div>

        <p class="cv-section-title">Certifications</p>
        @if (Model.Certificates != null && Model.Certificates.Any())
        {
            int certIndex = 0;
            @foreach (var cert in Model.Certificates)
            {
                string marginStyle = certIndex > 0 ? "margin-top: 4px;" : "";

                <div class="cv-row" style="@marginStyle">
                    <div class="left"><strong>@cert.Name</strong> &ndash; @cert.Issuer</div>
                    <div class="right">@DateTime.Parse(@cert.IssueDate).ToString("MMM yyyy")</div>
                </div>
            }
        }

        <p class="cv-section-title">Skills</p>
        <ul class="cv-bullets">
            @if (Model.Skills != null && Model.Skills.Any())
            {
                var groupedSkills = Model.Skills.GroupBy(s => string.IsNullOrWhiteSpace(s.Category) ? "Other" : s.Category);

                foreach (var group in groupedSkills)
                {
                    <li>
                        <strong>@group.Key:</strong> @string.Join(", ", group.Select(s => s.Name))
                    </li>
                }
            }
        </ul>

    </div>