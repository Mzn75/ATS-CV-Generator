@model ATS_CV_Generator.Models.CvDraft
@{
    ViewData["Title"] = "Education";
}

<div class="builder-container mx-auto" style="max-width: 700px; margin-top: 40px;">

    <!-- PROGRESS BAR -->
    <div class="step-indicator" style="padding-top:20px">
        <a asp-controller="CvBuilder" asp-action="PersonalInfo" class="step completed">
            <div class="step-circle"><i class="fa-solid fa-check"></i></div>
            <span class="step-label">Personal</span>
        </a>
        <a asp-controller="CvBuilder" asp-action="Education" class="step active">
            <div class="step-circle">2</div>
            <span class="step-label">Education</span>
        </a>
        <a asp-controller="CvBuilder" asp-action="Experience" class="step">
            <div class="step-circle">3</div>
            <span class="step-label">Experience</span>
        </a>
        <a asp-controller="CvBuilder" asp-action="Projects" class="step">
            <div class="step-circle">4</div>
            <span class="step-label">Projects</span>
        </a>
        <a asp-controller="CvBuilder" asp-action="Certificates" class="step">
            <div class="step-circle">5</div>
            <span class="step-label">Certificates</span>
        </a>
        <a asp-controller="CvBuilder" asp-action="Skills" class="step">
            <div class="step-circle">6</div>
            <span class="step-label">Skills</span>
        </a>
        <a asp-controller="CvBuilder" asp-action="Result" class="step">
            <div class="step-circle">7</div>
            <span class="step-label">Result</span>
        </a>
    </div>

    <h2 class="mb-4" style="color: #ffffff; font-weight: 700;">2. Education</h2>

    @if (Model.Educations != null && Model.Educations.Any())
    {
        <div class="saved-educations mb-4">
            <h5 style="color: var(--text-secondary); margin-bottom: 1rem;">Saved Education</h5>
            <div class="row">
                @foreach (var edu in Model.Educations)
                {
                    <div class="col-md-6 mb-3">
                        <div class="card p-3 h-100 d-flex flex-column" style="background: var(--surface-dark, #121C29); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px;">

                            <h5 style="color: var(--secondary-teal, #2A9D8F); margin-bottom: 5px; font-weight: 600;">@edu.Degree</h5>
                            <p style="color: var(--text-primary, #F8F9FB); margin-bottom: 5px;"><strong>@edu.Institution</strong></p>
                            <p style="color: var(--text-secondary, #94A3B8); margin-bottom: 5px; font-size: 0.9rem;">Major: @edu.Major</p>
                            <p style="color: var(--text-secondary, #94A3B8); margin-bottom: 10px; font-size: 0.85rem;">
                                <i class="fa-solid fa-calendar-days me-2"></i>Graduated: @edu.GradDate
                            </p>

                            <form asp-action="DeleteEducation" asp-controller="CvBuilder" method="post" style="margin-top: auto;">
                                <input type="hidden" name="id" value="@edu.Id" />
                                <button type="submit" class="remove-btn">
                                    <i class="fa-solid fa-xmark"></i> Remove
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- THE FORM -->
    <form asp-action="AddEducation" method="post" id="form">
        <!-- Hidden ID so Entity Framework knows which draft to update -->
        <input type="hidden" asp-for="Id" />
        @{
            bool hasItems = Model.Educations != null && Model.Educations.Any();
            string collapseClass = hasItems ? "collapse" : "collapse show";
            string expandedState = hasItems ? "false" : "true";
        }

        <div class="d-flex justify-content-between align-items-center mb-3 toggle-header"
             data-bs-toggle="collapse"
             data-bs-target="#collapseEdu"
             aria-expanded="@expandedState"
             style="cursor: pointer;">

            <h5 style="color: var(--text-secondary); margin-bottom: 0;">Add New Education</h5>
            <i class="fa-solid fa-chevron-up toggle-icon" style="color: var(--text-secondary); transition: transform 0.3s ease;"></i>
        </div>

        <div class="@collapseClass" id="collapseEdu">

            <div class="inputs-card">
                <div class="row">
                    <!-- Degree -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="NewEducation.Degree" class="form-label" style="color: var(--text-secondary);">Degree</label>

                        <div class="position-relative">
                            <input asp-for="NewEducation.Degree" class="form-control input-with-icon" type="text" placeholder="Enter your degree" />
                            <i class="fa-solid fa-graduation-cap custom-input-icon"></i>
                            <span asp-validation-for="NewEducation.Degree" class="field-validation-error text-danger"></span>
                        </div>
                    </div>

                    <!-- Major -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="NewEducation.Major" class="form-label" style="color: var(--text-secondary);">Major</label>

                        <div class="position-relative">
                            <input asp-for="NewEducation.Major" class="form-control input-with-icon" type="text" placeholder="Enter your major" />
                            <i class="fa-solid fa-book custom-input-icon"></i>
                            <span asp-validation-for="NewEducation.Major" class="field-validation-error text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <!-- Institution -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="NewEducation.Institution" class="form-label" style="color: var(--text-secondary);">Institution</label>

                        <div class="position-relative">
                            <input asp-for="NewEducation.Institution" class="form-control input-with-icon" type="text" placeholder="Enter the institution name" />
                            <i class="fa-solid fa-building-columns custom-input-icon"></i>
                            <span asp-validation-for="NewEducation.Institution" class="field-validation-error text-danger"></span>
                        </div>
                    </div>

                    <!-- Graduation Date -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="NewEducation.GradDate" class="form-label" style="color: var(--text-secondary);">Graduation Date</label>
                        <div class="position-relative">
                            <partial name="_CustomDatePicker" for="NewEducation.GradDate" />
                            <span asp-validation-for="NewEducation.GradDate" class="field-validation-error text-danger"></span>
                        </div>
                    </div>
                    <button type="submit" name="actionType" value="add" class="btn" style="background: var(--accent-coral)">
                        Save
                    </button>
                </div>
            </div>
        </div>
        <!-- Navigation Buttons -->
        <div class="nav-buttons d-flex justify-content-between mt-4">
            <!-- Back -->
            <a asp-controller="CvBuilder" asp-action="PersonalInfo" class="btn btn-nav btn-nav-back px-5 py-2">
                <i class="fa-solid fa-arrow-left me-2"></i> Personal Info
            </a>

            <!-- Next -->
            <button type="submit" name="actionType" value="next" class="btn btn-nav btn-nav-next px-5 py-2">
                Next: Experience <i class="fa-solid fa-arrow-right ms-2"></i>
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const form = document.getElementById("form");
            if (!form) return;

            // Grab all inputs and textareas inside the form
            const inputs = form.querySelectorAll("input, textarea");

            inputs.forEach(input => {
                // Ignore hidden inputs (like the ID field)
                if (input.type === 'hidden' || !input.name) return;

                // 1. RESTORE DATA: If the input is empty, check if we have saved data
                if (!input.value) {
                    const savedValue = sessionStorage.getItem('cvDraft_' + input.name);
                    if (savedValue) {
                        input.value = savedValue;
                    }
                }

                // 2. SAVE DATA: As the user types, save it to Session Storage
                input.addEventListener("input", function() {
                    sessionStorage.setItem('cvDraft_' + input.name, input.value);
                });
            });

            // 3. CLEAN UP: When they officially submit, wipe the temporary storage
            form.addEventListener("submit", function() {
                inputs.forEach(input => {
                    if (input.name) {
                        sessionStorage.removeItem('cvDraft_' + input.name);
                    }
                });
            });
        });
    </script>
}