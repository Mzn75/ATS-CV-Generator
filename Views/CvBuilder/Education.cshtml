@model ATS_CV_Generator.Models.CvDraft
@{
    ViewData["Title"] = "Education";
}

<div class="builder-container mx-auto" style="max-width: 700px; margin-top: 40px;">

    <!-- PROGRESS BAR -->
    <div class="progress-wrapper mb-5">
        <div class="d-flex justify-content-between mb-2" style="color: var(--text-secondary); font-size: 0.9rem; font-weight: 600;">
            <span>PROGRESS</span>
            <span>40%</span>
        </div>
        <div class="progress" style="height: 8px; background-color: #2a2b38; border-radius: 4px; overflow: hidden;">
            <div class="progress-bar" role="progressbar" style="width: 40%; background-color: var(--secondary-teal, --accent-coral);"></div>
        </div>
    </div>

    <h2 class="mb-4" style="color: #ffffff; font-weight: 700;">2. Education</h2>
    <p style="color: var(--text-secondary); margin-bottom: 30px;">
        @foreach (var edu in Model.Educations)
        {
            <div>@edu.Degree at @edu.Institution</div>
        }
    </p>

    <!-- THE FORM -->
    <form asp-action="AddEducation" method="post" id="form">
        <!-- Hidden ID so Entity Framework knows which draft to update -->
        <input type="hidden" asp-for="Id" />

        <div class="inputs-card">
        <div class="row">
            <!-- Degree -->
            <div class="col-md-6 mb-3">
                <label asp-for="NewEducation.Degree" class="form-label" style="color: var(--text-secondary);">Degree</label>
            
                <div class="position-relative">
                    <input asp-for="NewEducation.Degree" class="form-control input-with-icon" type="text" placeholder="Enter your degree" />
                    <i class="fa-solid fa-graduation-cap custom-input-icon"></i>
                    <span asp-validation-for="NewEducation.Degree" class="field-validation-error text-danger"></span>
                </div>
            </div>

            <!-- Major -->
            <div class="col-md-6 mb-3">
                <label asp-for="NewEducation.Major" class="form-label" style="color: var(--text-secondary);">Major</label>
            
                <div class="position-relative">
                    <input asp-for="NewEducation.Major" class="form-control input-with-icon" type="email" placeholder="Enter your major" />
                    <i class="fa-solid fa-book custom-input-icon"></i>
                    <span asp-validation-for="NewEducation.Major" class="field-validation-error text-danger"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Institution -->
            <div class="col-md-6 mb-3">
                <label asp-for="NewEducation.Institution" class="form-label" style="color: var(--text-secondary);">Institution</label>
                
                <div class="position-relative">
                    <input asp-for="NewEducation.Institution" class="form-control input-with-icon" type="tel" placeholder="Enter the institution name" />
                    <i class="fa-solid fa-building-columns custom-input-icon"></i>
                    <span asp-validation-for="NewEducation.Institution" class="field-validation-error text-danger"></span>
                </div>
            </div>

            <!-- Graduation Date -->
            <div class="col-md-6 mb-3">
                <label asp-for="NewEducation.GradDate" class="form-label" style="color: var(--text-secondary);">Graduation Date</label>
                <div class="position-relative">
                    <input asp-for="NewEducation.GradDate" class="form-control input-with-icon" type="date" placeholder="Choose the graduation date" />
                    <i class="fa-solid fa-calendar-days custom-input-icon"></i>
                    <span asp-validation-for="NewEducation.GradDate" class="field-validation-error text-danger"></span>
                </div>
            </div>
        </div>
        </div>
        <!-- Navigation Buttons -->
        <div class="nav-buttons d-flex justify-content-between mt-4">
            <!-- Back -->
            <a asp-controller="CvBuilder" asp-action="PersonalInfo"
               class="btn btn-nav btn-nav-back px-5 py-2">
                <i class="fa-solid fa-arrow-left me-2"></i> Personal Info
            </a>

            <!-- Next -->
            <button type="submit" class="btn btn-nav btn-nav-next px-5 py-2">
                Next: Experience <i class="fa-solid fa-arrow-right ms-2"></i>
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const form = document.getElementById("form");
            if (!form) return;

            // Grab all inputs and textareas inside the form
            const inputs = form.querySelectorAll("input, textarea");

            inputs.forEach(input => {
                // Ignore hidden inputs (like the ID field)
                if (input.type === 'hidden' || !input.name) return;

                // 1. RESTORE DATA: If the input is empty, check if we have saved data
                if (!input.value) {
                    const savedValue = sessionStorage.getItem('cvDraft_' + input.name);
                    if (savedValue) {
                        input.value = savedValue;
                    }
                }

                // 2. SAVE DATA: As the user types, save it to Session Storage
                input.addEventListener("input", function() {
                    sessionStorage.setItem('cvDraft_' + input.name, input.value);
                });
            });

            // 3. CLEAN UP: When they officially submit, wipe the temporary storage
            form.addEventListener("submit", function() {
                inputs.forEach(input => {
                    if (input.name) {
                        sessionStorage.removeItem('cvDraft_' + input.name);
                    }
                });
            });
        });
    </script>
}