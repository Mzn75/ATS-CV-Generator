@model ATS_CV_Generator.Models.CvDraft
@{
    ViewData["Title"] = "Skills";
}

<div class="builder-container mx-auto" style="max-width: 700px; margin-top: 40px;">

    <!-- PROGRESS BAR -->
    <div class="step-indicator" style="padding-top:20px">
        <a asp-controller="CvBuilder" asp-action="PersonalInfo" class="step completed">
            <div class="step-circle"><i class="fa-solid fa-check"></i></div>
            <span class="step-label">Personal</span>
        </a>
        <a asp-controller="CvBuilder" asp-action="Education" class="step completed">
            <div class="step-circle"><i class="fa-solid fa-check"></i></div>
            <span class="step-label">Education</span>
        </a>
        <a asp-controller="CvBuilder" asp-action="Experience" class="step completed">
            <div class="step-circle"><i class="fa-solid fa-check"></i></div>
            <span class="step-label">Experience</span>
        </a>
        <a asp-controller="CvBuilder" asp-action="Projects" class="step completed">
            <div class="step-circle"><i class="fa-solid fa-check"></i></div>
            <span class="step-label">Projects</span>
        </a>
        <a asp-controller="CvBuilder" asp-action="Certificates" class="step completed">
            <div class="step-circle"><i class="fa-solid fa-check"></i></div>
            <span class="step-label">Certificates</span>
        </a>
        <a asp-controller="CvBuilder" asp-action="Skills" class="step active">
            <div class="step-circle">6</div>
            <span class="step-label">Skills</span>
        </a>
        <a asp-controller="CvBuilder" asp-action="Result" class="step">
            <div class="step-circle">7</div>
            <span class="step-label">Result</span>
        </a>
    </div>

    <h2 class="mb-4" style="color: #ffffff; font-weight: 700;">6. Skills</h2>

    
    @if (Model.Skills != null && Model.Skills.Any())
    {
        <div class="mb-4">
            <h5 style="color: var(--text-secondary); margin-bottom: 1rem;">Saved Skills</h5>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var skl in Model.Skills)
                {
                    <span class="skill-badge">
                        <span class="skill-badge-category">@skl.Category</span>
                        <span class="skill-badge-name">@skl.Name</span>

                        <form asp-action="DeleteSkill" asp-controller="CvBuilder" method="post" style="margin-top: auto;">
                            <input type="hidden" name="id" value="@skl.Id" />
                            <button type="submit" class="remove-btn">
                                <i class="fa-solid fa-xmark"></i> Remove
                            </button>
                        </form>
                    </span>

                }
            </div>
        </div>
    }

    <!-- THE FORM -->
    <form asp-action="AddSkill" method="post" id="form">
        <!-- Hidden ID so Entity Framework knows which draft to update -->
        <input type="hidden" asp-for="Id" />

        @{
            bool hasItems = Model.Skills != null && Model.Skills.Any();
            string collapseClass = hasItems ? "collapse" : "collapse show";
            string expandedState = hasItems ? "false" : "true";
        }

        <div class="d-flex justify-content-between align-items-center mb-3 toggle-header"
             data-bs-toggle="collapse"
             data-bs-target="#collapseSkill"
             aria-expanded="@expandedState"
             style="cursor: pointer;">

            <h5 style="color: var(--text-secondary); margin-bottom: 0;">Add New Skill</h5>
            <i class="fa-solid fa-chevron-up toggle-icon" style="color: var(--text-secondary); transition: transform 0.3s ease;"></i>
        </div>


        <div class="@collapseClass" id="collapseSkill">
            <div class="inputs-card">
                <div class="row">
                    <!-- Skill Category -->
                    <div class="mb-3">
                        <label asp-for="NewSkill.Category" class="form-label" style="color: var(--text-secondary);">Category</label>
                        <div class="position-relative">

                            <input asp-for="NewSkill.Category" id="categoryInput" class="form-control input-with-icon" type="text" placeholder="Enter or select category" autocomplete="off" />
                            <i class="fa-solid fa-layer-group custom-input-icon"></i>

                            <!-- The visual dropdown arrow -->
                            <i class="fa-solid fa-chevron-down position-absolute" id="categoryArrow" style="right: 15px; top: 50%; transform: translateY(-50%); color: var(--text-secondary); pointer-events: none; transition: transform 0.3s ease; cursor:pointer;"></i>

                            <!-- The custom styled dropdown menu -->
                            <div class="custom-dropdown" id="categoryDropdown">
                                @if (ViewBag.StandardSkills != null)
                                {
                                    var shownCategories = new HashSet<string>();

                                    foreach (var skill in ViewBag.StandardSkills)
                                    {
                                        // Only render the category if it hasn't been added to the HashSet yet
                                        if (!string.IsNullOrWhiteSpace(skill.Category) && shownCategories.Add(skill.Category))
                                        {
                                            <div class="dropdown-item">@skill.Category</div>
                                        }
                                    }
                                }
                            </div>

                            <span asp-validation-for="NewSkill.Category" class="field-validation-error text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="row"> 
                    <!-- Skill Name -->
                    <div class="mb-3">
                        <label asp-for="NewSkill.Name" class="form-label" style="color: var(--text-secondary);">Skill Name</label>
                        <div class="position-relative">

                            <input asp-for="NewSkill.Name" id="nameInput" class="form-control input-with-icon" type="text" placeholder="Enter or choose your skill name" />
                            <i class="fa-solid fa-award custom-input-icon"></i>

                            <!-- The visual dropdown arrow -->
                            <i class="fa-solid fa-chevron-down position-absolute" id="nameArrow" style="right: 15px; top: 50%; transform: translateY(-50%); color: var(--text-secondary); pointer-events: none; transition: transform 0.3s ease; cursor:pointer;"></i>

                            <!-- The custom styled dropdown menu -->
                            <div class="custom-dropdown" id="nameDropdown">
                               
                                @if (ViewBag.StandardSkills != null)
                                {
                                    foreach (var skill in ViewBag.StandardSkills)
                                    {
                                        <div class="dropdown-item" data-category="@skill.Category">@skill.Name</div>
                                    }
                                }

                            </div>

                            <span asp-validation-for="NewSkill.Name" class="field-validation-error text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <button type="submit" name="actionType" value="add" class="btn" style="background: var(--accent-coral)">
                        Save
                    </button>
                </div>

            </div>
        </div>

        <!-- Navigation Buttons -->
        <div class="nav-buttons d-flex justify-content-between mt-4">
            <!-- Back -->
            <a asp-controller="CvBuilder" asp-action="Certificates"
               class="btn btn-nav btn-nav-back px-5 py-2">
                <i class="fa-solid fa-arrow-left me-2"></i> Certificates
            </a>

            <!-- Next -->
            <button type="submit" name="actionType" value="next" class="btn btn-nav btn-nav-next px-5 py-2">
                Finish
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {

            // --- 1. Session Storage Logic (Keep as is) ---
            const form = document.getElementById("form");
            if (form) {
                const formInputs = form.querySelectorAll("input, textarea");
                formInputs.forEach(input => {
                    if (input.type === 'hidden' || !input.name) return;

                    if (!input.value) {
                        const savedValue = sessionStorage.getItem('cvDraft_' + input.name);
                        if (savedValue) input.value = savedValue;
                    }

                    input.addEventListener("input", function() {
                        sessionStorage.setItem('cvDraft_' + input.name, input.value);
                    });
                });

                form.addEventListener("submit", function() {
                    formInputs.forEach(input => {
                        if (input.name) sessionStorage.removeItem('cvDraft_' + input.name);
                    });
                });
            }

            // --- 2. Element Selectors ---
            const categoryInput = document.getElementById('categoryInput');
            const categoryDropdown = document.getElementById('categoryDropdown');
            // FIX: Only get items inside the Category dropdown
            const categoryItems = categoryDropdown.querySelectorAll('.dropdown-item');
            const categoryArrow = document.getElementById('categoryArrow');

            const nameInput = document.getElementById('nameInput');
            const nameDropdown = document.getElementById('nameDropdown');
            // FIX: Only get items inside the Name dropdown
            const nameItems = nameDropdown.querySelectorAll('.dropdown-item');
            const nameArrow = document.getElementById('nameArrow');

            // --- 3. Shared Toggle Functions ---
            function openDropdown(dropdown, arrow) {
                dropdown.classList.add('show');
                if (arrow) arrow.style.transform = 'translateY(-50%) rotate(180deg)';
            }

            function closeDropdown(dropdown, arrow) {
                dropdown.classList.remove('show');
                if (arrow) arrow.style.transform = 'translateY(-50%) rotate(0deg)';
            }

            // --- 4. Cross-Filtering Logic (Category -> Name) ---
            function filterSkillsByCategory() {
                const selectedCategory = categoryInput.value.toLowerCase().trim();

                nameItems.forEach(item => {
                    const itemCategory = (item.getAttribute('data-category') || "").toLowerCase();

                    if (selectedCategory === "" || itemCategory === selectedCategory) {
                        item.style.display = 'block';
                        item.classList.remove('category-hidden');
                    } else {
                        item.style.display = 'none';
                        item.classList.add('category-hidden');
                    }
                });
            }

            // --- 5. Category Input Events ---
            categoryInput.addEventListener('focus', () => openDropdown(categoryDropdown, categoryArrow));

            categoryInput.addEventListener('input', function() {
                openDropdown(categoryDropdown, categoryArrow);
                const filterText = categoryInput.value.toLowerCase().trim();

                categoryItems.forEach(item => {
                    const itemText = item.textContent.toLowerCase();
                    item.style.display = itemText.includes(filterText) ? 'block' : 'none';
                });

                filterSkillsByCategory(); // Trigger skill filter as they type
            });

            categoryItems.forEach(item => {
                item.addEventListener('click', () => {
                    categoryInput.value = item.textContent;
                    closeDropdown(categoryDropdown, categoryArrow);
                    categoryItems.forEach(i => i.style.display = 'block');

                    filterSkillsByCategory(); // Trigger skill filter on click
                });
            });

            // --- 6. Name Input Events ---
            nameInput.addEventListener('focus', () => openDropdown(nameDropdown, nameArrow));

            nameInput.addEventListener('input', function() {
                openDropdown(nameDropdown, nameArrow);
                const filterText = nameInput.value.toLowerCase().trim();

                nameItems.forEach(item => {
                    // FIX: Don't show the skill if the category filter already hid it
                    if (item.classList.contains('category-hidden')) return;

                    const itemText = item.textContent.toLowerCase();
                    item.style.display = itemText.includes(filterText) ? 'block' : 'none';
                });
            });

            nameItems.forEach(item => {
                item.addEventListener('click', () => {
                    nameInput.value = item.textContent;
                    closeDropdown(nameDropdown, nameArrow);

                    // Reset visibility, but respect the category filter
                    nameItems.forEach(i => {
                        if (!i.classList.contains('category-hidden')) {
                            i.style.display = 'block';
                        }
                    });
                });
            });

            // --- 7. Global Click-Away Listener ---
            document.addEventListener('click', (e) => {
                if (!categoryInput.contains(e.target) && !categoryDropdown.contains(e.target)) {
                    closeDropdown(categoryDropdown, categoryArrow);
                }
                if (!nameInput.contains(e.target) && !nameDropdown.contains(e.target)) {
                    closeDropdown(nameDropdown, nameArrow);
                }
            });
        });
    </script>
}
