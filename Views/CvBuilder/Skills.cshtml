@model ATS_CV_Generator.Models.CvDraft
@{
    ViewData["Title"] = "Skills";
}

<div class="builder-container mx-auto" style="max-width: 700px; margin-top: 40px;">

    <!-- PROGRESS BAR -->
    <div class="progress-wrapper mb-5">
        <div class="d-flex justify-content-between mb-2" style="color: var(--text-secondary); font-size: 0.9rem; font-weight: 600;">
            <span>PROGRESS</span>
            <span>100%</span>
        </div>
        <div class="progress" style="height: 8px; background-color: #2a2b38; border-radius: 4px; overflow: hidden;">
            <div class="progress-bar" role="progressbar" style="width: 100%; background-color: var(--secondary-teal, --accent-coral);"></div>
        </div>
    </div>

    <h2 class="mb-4" style="color: #ffffff; font-weight: 700;">6. Skills</h2>

    <!-- THE FORM -->
    <form asp-action="AddCertificate" method="post" id="form">
        <!-- Hidden ID so Entity Framework knows which draft to update -->
        <input type="hidden" asp-for="Id" />

        @if (Model.Skills != null && Model.Skills.Any())
        {
            <div class="mb-4">
                <h5 style="color: var(--text-secondary); margin-bottom: 1rem;">Saved Skills</h5>
                <div class="row">
                    @foreach (var skl in Model.Skills)
                    {
                        <div class="col-md-6 mb-3">
                            <div class="card p-3 h-100" style="background: var(--surface-dark, #121C29); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px;">
                                <p style="color: var(--text-primary, #F8F9FB); margin-bottom: 5px;"><strong>@skl.Category</strong></p>
                                <h5 style="color: var(--secondary-teal, #2A9D8F); margin-bottom: 5px; font-weight: 600;">@skl.Name</h5>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        @{
            bool hasItems = Model.Skills != null && Model.Skills.Any();
            string collapseClass = hasItems ? "collapse" : "collapse show";
            string expandedState = hasItems ? "false" : "true";
        }

        <div class="d-flex justify-content-between align-items-center mb-3 toggle-header"
             data-bs-toggle="collapse"
             data-bs-target="#collapseSkill"
             aria-expanded="@expandedState"
             style="cursor: pointer;">

            <h5 style="color: var(--text-secondary); margin-bottom: 0;">Add New Skill</h5>
            <i class="fa-solid fa-chevron-up toggle-icon" style="color: var(--text-secondary); transition: transform 0.3s ease;"></i>
        </div>


        <div class="@collapseClass" id="collapseSkill">
            <div class="inputs-card">
                <div class="row">
                    <!-- Skill Category -->
                    <div class="mb-3">
                        <label asp-for="NewSkill.Category" class="form-label" style="color: var(--text-secondary);">Category</label>
                        <div class="position-relative">

                            <input asp-for="NewSkill.Category" id="categoryInput" class="form-control input-with-icon" type="text" placeholder="Enter or select category" autocomplete="off" />
                            <i class="fa-solid fa-layer-group custom-input-icon"></i>

                            <!-- The visual dropdown arrow -->
                            <i class="fa-solid fa-chevron-down position-absolute" id="categoryArrow" style="right: 15px; top: 50%; transform: translateY(-50%); color: var(--text-secondary); pointer-events: none; transition: transform 0.3s ease; cursor:pointer;"></i>

                            <!-- The custom styled dropdown menu -->
                            <div class="custom-dropdown" id="categoryDropdown">
                                <div class="dropdown-item">Programming Languages</div>
                                <div class="dropdown-item">Frameworks & Libraries</div>
                                <div class="dropdown-item">Databases</div>
                                <div class="dropdown-item">Tools & Software</div>
                                <div class="dropdown-item">Soft Skills</div>
                                <div class="dropdown-item">Languages</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row"> 
                    <!-- Certificate Name -->
                    <div class="mb-3">
                        <label asp-for="NewSkill.Name" class="form-label" style="color: var(--text-secondary);">Skill Name</label>
                        <div class="position-relative">
                            <input asp-for="NewSkill.Name" class="form-control input-with-icon" type="text" placeholder="Enter your skill name" />
                            <i class="fa-solid fa-award custom-input-icon"></i>
                            <span asp-validation-for="NewSkill.Name" class="field-validation-error text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row">

                <div class="row">
                    <button type="submit" name="actionType" value="add" class="btn" style="background: var(--accent-coral)">
                        Save
                    </button>
                </div>

            </div>
        </div>

        <!-- Navigation Buttons -->
        <div class="nav-buttons d-flex justify-content-between mt-4">
            <!-- Back -->
            <a asp-controller="CvBuilder" asp-action="Projects"
               class="btn btn-nav btn-nav-back px-5 py-2">
                <i class="fa-solid fa-arrow-left me-2"></i> Projects
            </a>

            <!-- Next -->
            <button type="submit" name="actionType" value="next" class="btn btn-nav btn-nav-next px-5 py-2">
                Next: Skills
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const form = document.getElementById("form");
            if (!form) return;

            const inputs = form.querySelectorAll("input, textarea");

            inputs.forEach(input => {
                if (input.type === 'hidden' || !input.name) return;

                if (!input.value) {
                    const savedValue = sessionStorage.getItem('cvDraft_' + input.name);
                    if (savedValue) {
                        input.value = savedValue;
                    }
                }

                input.addEventListener("input", function() {
                    sessionStorage.setItem('cvDraft_' + input.name, input.value);
                });
            });

            form.addEventListener("submit", function() {
                inputs.forEach(input => {
                    if (input.name) {
                        sessionStorage.removeItem('cvDraft_' + input.name);
                    }
                });
            });
        });
        document.addEventListener("DOMContentLoaded", function() {
            const input = document.getElementById('categoryInput');
            const dropdown = document.getElementById('categoryDropdown');
            const items = document.querySelectorAll('.dropdown-item');
            const arrow = document.getElementById('categoryArrow');

            function openDropdown() {
                dropdown.classList.add('show');
                arrow.style.transform = 'translateY(-50%) rotate(180deg)';
            }

            function closeDropdown() {
                dropdown.classList.remove('show');
                arrow.style.transform = 'translateY(-50%) rotate(0deg)';
            }

            // 1. Open menu when user clicks the input
            input.addEventListener('focus', openDropdown);

            // 2. Filter the list as the user types
            input.addEventListener('input', function() {
                openDropdown(); // Keep it open while typing
                const filterText = input.value.toLowerCase();

                items.forEach(item => {
                    const itemText = item.textContent.toLowerCase();
                    // Hide the item if it doesn't match the search text
                    if (itemText.includes(filterText)) {
                        item.style.display = 'block';
                    } else {
                        item.style.display = 'none';
                    }
                });
            });

            // 3. Close menu if user clicks away
            document.addEventListener('click', (e) => {
                if (!input.contains(e.target) && !dropdown.contains(e.target)) {
                    closeDropdown();
                }
            });

            // 4. Handle clicking a predefined option
            items.forEach(item => {
                item.addEventListener('click', () => {
                    input.value = item.textContent;
                    closeDropdown();

                    // Reset all items to visible for the next time they open the menu
                    items.forEach(i => i.style.display = 'block');
                });
            });
        });
    </script>
}
